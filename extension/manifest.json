{
  "manifest_version": 3,
  "name": "Tickerline",
  "version": "1.0.6",
  "description": "Put your name, role and contact details on your camera in Google Meet. A clean broadcast strip that survives background blur.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tickerline",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "strip.js",
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-strip": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Turn the strip on or off"
    }
  }
}
